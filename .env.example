# PropertyUnit — Environment Variables
# Copy this file to .env.local for local development.
# In Vercel: add these under Project → Settings → Environment Variables.
# NEVER commit .env.local

# Backend API base URL
# Local dev:  http://localhost:8080/api/v1
# Production: https://api.propertyunit.in/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Razorpay public key (safe to expose — public key only)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# App public URL
VITE_APP_URL=https://propertyunit.in
